# ==================== GLOBAL CONFIG ====================
NODE_ENV=development
LOG_LEVEL=debug

# ==================== DATABASE ====================
DATABASE_URL=postgresql://pixora:pixora@localhost:5432/pixora
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== S3 STORAGE ====================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pixora-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/pixora-assets
S3_FORCE_PATH_STYLE=true

# ==================== BACKEND API ====================
API_PORT=4000
API_PREFIX=/api
API_CORS_ORIGIN=http://localhost:3000

# ==================== WEBSOCKET SERVER ====================
WS_PORT=4001

# ==================== JWT ====================
JWT_SECRET=change-me-in-production-super-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# ==================== OAUTH2 ====================
# Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# GitHub (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# ==================== STRIPE ====================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Products (IDs from Stripe Dashboard)
STRIPE_PRODUCT_STARTER=price_starter_xxx
STRIPE_PRODUCT_PRO=price_pro_xxx
STRIPE_PRODUCT_BUSINESS=price_business_xxx

# ==================== AI SERVICES ====================
# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Stability AI
STABILITY_API_KEY=sk-your-stability-key

# Replicate
REPLICATE_API_TOKEN=r8_your-replicate-token

# OpenAI (optional)
OPENAI_API_KEY=sk-your-openai-key

# ==================== MONITORING ====================
# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus
PROMETHEUS_PORT=9090

# ==================== EMAIL ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@pixora.com

# ==================== FRONTEND ====================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
NEXT_PUBLIC_ENABLE_OAUTH=true
NEXT_PUBLIC_ENABLE_AI_TOOLS=true
NEXT_PUBLIC_ENABLE_COLLABORATION=true

# ==================== RATE LIMITING ====================
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ==================== TOKEN PACKAGES ====================
TOKEN_PACKAGE_STARTER=100
TOKEN_PACKAGE_PRO=500
TOKEN_PACKAGE_BUSINESS=2000
